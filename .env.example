# Copy to .env and adjust values before running: docker compose up --build

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_manager

# Backend
JWT_SECRET_KEY=change-me-in-production
JWT_COOKIE_SECURE=false
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:8080
BACKEND_PORT=5000

# Mail (optional for local Docker; leave blank to skip real email delivery)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Seeded admin account (created on first backend start when SEED_ON_START=true)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ON_START=true

# Frontend (baked into the Vite build at image build time)
VITE_API_URL=http://localhost:5000
VITE_APP_URL=http://localhost:8080
FRONTEND_PORT=8080